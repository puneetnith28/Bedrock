# Bedrock configuration. Copy to .env (or ~/.conduit/.env for the desktop app).
# Nothing is required to run locally. See docs/environment.md for every variable.

# Basic auth for the web UI — required before exposing the port (user:pass)
CONDUIT_AUTH=

# Supervisor: auto | bedrock | anthropic | local   (off disables it: CONDUIT_SUPERVISOR=off)
SUPERVISOR_PROVIDER=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
ANTHROPIC_API_KEY=

# Local model server — LocalHarness agents, SUPERVISOR_PROVIDER=local, the LocalHarness Keeper
# (also settable in Settings -> Local model; these win)
LOCAL_LLM_BASE_URL=
LOCAL_LLM_MODEL=
LOCAL_LLM_API_KEY=

# Keeper engine: codex | claude | localharness (auto when unset)
CONDUIT_KEEPER_ENGINE=

# Hosted agent CLIs
GROQ_API_KEY=
OPENROUTER_API_KEY=
