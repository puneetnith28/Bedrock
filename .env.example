# Bedrock Environment Configuration Template
# Copy this file to .env (or ~/.conduit/.env for the native desktop app).
#
# IMPORTANT: All variables are OPTIONAL for basic local operation.
# Bedrock runs out of the box with zero configuration for local terminal management.
# Detailed descriptions: docs/environment.md

# ==============================================================================
# 1. Networking & Access Control (Optional)
# ==============================================================================
# Port for the Web & API Server (Default: 3200)
PORT=3200

# Port for the Bedrock Daemon process (Default: 3210)
CONDUIT_DAEMON_PORT=3210

# Basic authentication for the web console and WebSocket hub (user:password)
# STRONGLY RECOMMENDED if binding to a public interface or shared network
# Default: unset (open on localhost)
CONDUIT_AUTH=

# ==============================================================================
# 2. Ambient Supervisory Layer (Optional)
# ==============================================================================
# Supervisor provider: auto | bedrock | anthropic | local | off
# Default: auto (resolves based on available credentials)
SUPERVISOR_PROVIDER=auto

# AWS configuration for Amazon Bedrock Supervisor & Nova Sonic Voice
# Required only when SUPERVISOR_PROVIDER=bedrock or using voice features
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Anthropic API Key (used for Claude Code agents or Anthropic supervisor fallback)
ANTHROPIC_API_KEY=

# ==============================================================================
# 3. Offline & Local Model Execution (LocalHarness) (Optional)
# ==============================================================================
# OpenAI-compatible local model server (Ollama, LM Studio, vLLM, llama.cpp)
# Can also be configured in the UI under Settings -> Local model
LOCAL_LLM_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_LLM_MODEL=qwen2.5-coder:latest
LOCAL_LLM_API_KEY=not-needed

# ==============================================================================
# 4. The Keeper Intelligence Engine (Optional)
# ==============================================================================
# Engine to power cross-project Keeper coordination: codex | claude | localharness
# Default: auto-detected based on available credentials and runtimes
CONDUIT_KEEPER_ENGINE=

# ==============================================================================
# 5. Hosted Agent CLI Keys (Optional)
# ==============================================================================
# OpenAI API Key (for Codex CLI agents or Whisper fallback)
OPENAI_API_KEY=

# Google Gemini API Key (for Gemini CLI agents or voice capabilities)
GEMINI_API_KEY=

# Hosted agent CLIs (e.g. aider integrations)
GROQ_API_KEY=
OPENROUTER_API_KEY=
